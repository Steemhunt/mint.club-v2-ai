{
  "name": "mintclub-mcp",
  "version": "0.2.0",
  "mcpName": "io.github.h1-hunt/mintclub",
  "description": "Model Context Protocol server for Mint Club V2 on Base and Robinhood Chain",
  "type": "module",
  "main": "dist/index.js",
  "module": "./src/index.ts",
  "bin": {
    "mintclub-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mint-club",
    "bonding-curve",
    "defi",
    "base",
    "robinhood-chain",
    "ai",
    "claude",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Steemhunt/mint.club-v2-ai.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/Steemhunt/mint.club-v2-ai/tree/main/mcp",
  "bugs": {
    "url": "https://github.com/Steemhunt/mint.club-v2-ai/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "mint.club-cli": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun": "^1.3.14",
    "bun-types": "^1.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
