{
  "name": "@mint.club/v2-mcp",
  "version": "2.0.1",
  "mcpName": "io.github.h1-hunt/mintclub",
  "description": "MCP server for Mint Club V2 Bond operations and bounded local Uniswap ZapV2 routing across supported chains",
  "type": "module",
  "main": "dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "mintclub-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "bash build.sh",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mint-club",
    "bonding-curve",
    "defi",
    "uniswap",
    "zap-v2",
    "multi-chain",
    "robinhood-chain",
    "ai",
    "claude",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Steemhunt/mint.club-v2-ai.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/Steemhunt/mint.club-v2-ai/tree/main/mcp",
  "bugs": {
    "url": "https://github.com/Steemhunt/mint.club-v2-ai/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mint.club/v2-cli": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun": "^1.3.14",
    "bun-types": "^1.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
