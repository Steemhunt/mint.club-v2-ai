{
  "name": "@mint.club/v2-cli",
  "version": "2.0.0",
  "description": "All-chain Mint Club V2 CLI with bounded local Uniswap ZapV2 routing",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./chain-registry.json": "./chain-registry.json"
  },
  "files": [
    "dist",
    "README.md",
    "build.sh",
    "chain-registry.json"
  ],
  "bin": {
    "mc": "dist/index.js"
  },
  "scripts": {
    "build": "bash build.sh",
    "prepublishOnly": "bash build.sh",
    "start": "bun src/index.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "RUN_INTEGRATION_TESTS=1 vitest run test/cli.test.ts",
    "test:fork": "RUN_FORK_TESTS=1 vitest run test/write.test.ts"
  },
  "keywords": [
    "mint-club",
    "bonding-curve",
    "cli",
    "web3",
    "uniswap",
    "universal-router",
    "zap-v2",
    "multi-chain",
    "viem",
    "defi",
    "token-launch"
  ],
  "homepage": "https://github.com/Steemhunt/mint.club-v2-ai#readme",
  "bugs": {
    "url": "https://github.com/Steemhunt/mint.club-v2-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Steemhunt/mint.club-v2-ai.git",
    "directory": "cli"
  },
  "author": "h1-hunt <h1@hunt.town>",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "viem": "^2.21.49"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@uniswap/sdk-core": "^7.18.0",
    "@uniswap/universal-router-sdk": "^5.9.0",
    "bun": "^1.3.14",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
